# Скопируйте в .env и поправьте при необходимости.

# Порт шлюза на сервере. 80 - чтобы открывалось просто по http://tmvos.panel
HTTP_PORT=80

# Образы. Если на сервере нет доступа к Docker Hub, укажите те теги, что уже
# загружены (`docker images`), например из nginx.tar / node.tar.
NGINX_IMAGE=nginx:alpine
NODE_IMAGE=node:24-alpine
